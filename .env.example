# Yoco Checkout API (South Africa) — https://developer.yoco.com
# Get your keys in the Yoco App → Checkout API integration:
#   https://app.yoco.com/manage/yoco-connect/integration?name=checkout_api
# Start with the TEST secret key; switch to the LIVE key once your domain is
# verified. WITHOUT these the shop runs in "demo" mode (no payments taken).
YOCO_SECRET_KEY=
# Optional override (defaults to the Yoco production endpoint).
YOCO_API_URL=https://payments.yoco.com/api

# Yoco webhook signing secret (whsec_...) — returned ONCE when you register a
# webhook. Register it with:
#   curl -X POST http://localhost:3000/api/yoco/webhooks/register
# then paste the returned `secret` here. Required so we can trust webhook
# notifications and mark orders as PAID (never rely on redirect URLs).
YOCO_WEBHOOK_SECRET=

# Public site URL (used for Yoco success/cancel/failure redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PAXI delivery (collect at your nearest PEP store). PAXI has no public rate API,
# so delivery uses flat-rate pricing by bag size × speed, defined in
# src/lib/paxiPricing.ts (matches paxi.co.za: standard bag R59.95 / R109.95,
# large bag R109.95 / R139.95). Update the constants there if pricing changes.

# Neon/Postgres database
# Get yours at https://console.neon.tech (New Project → Connection String)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth secret (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=