# PayFast (South Africa) — https://www.payfast.co.za/
# Create merchant credentials in your PayFast dashboard, then fill these in.
# Without them the shop runs in "demo" checkout mode (no payments taken).

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional but recommended: set a passphrase in PayFast settings (letters, numbers, -_/)
PAYFAST_PASSPHRASE=
# Set to "true" to send payments to PayFast's sandbox for testing
PAYFAST_TEST_MODE=true

# Public site URL (used for PayFast return/cancel/notify URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon/Postgres database
# Get yours at https://console.neon.tech (New Project → Connection String)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth secret (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=